{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow-peer-review-pi request",
  "description": "Pi-subagents 0.72.1 envelope: <=16384 UTF-8 JSON bytes total, nonempty strings, <=16 properties/object, <=64 items/array, nesting <=8. Inline evidence <=8192 UTF-8 JSON bytes total; script enforces byte and cross-field constraints. Parent assertions do not prove external facts.",
  "type": "object",
  "properties": {
    "cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/(?!.*(?:\\\\|//|/\\.\\.?(/|$)))[^\\u0000-\\u001f]*[^/]$"
    },
    "outputDir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/(?!.*(?:\\\\|//|/\\.\\.?(/|$)))[^\\u0000-\\u001f]*[^/]$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sourceRoots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^/(?!.*(?:\\\\|//|/\\.\\.?(/|$)))[^\\u0000-\\u001f]*[^/]$"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "authorization": {
      "type": "object",
      "properties": {
        "parentVerified": {
          "const": true
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 1,
          "maxItems": 8
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:\\.\\.|\\\\|\\*|\\?|\\[|\\]))[^\\u0000-\\u001f]+$"
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "parentVerified",
        "evidence",
        "actions",
        "files"
      ],
      "additionalProperties": false,
      "maxProperties": 16
    },
    "preflight": {
      "type": "object",
      "properties": {
        "pathsVerified": {
          "const": true
        },
        "rolesVerified": {
          "const": true
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "piVersion": {
          "const": "0.87.1"
        },
        "subagentsVersion": {
          "const": "0.72.1"
        },
        "snapshotUse": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "snapshotId": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "environmentIdentitySha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "observedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "maxLength": 100
            }
          },
          "required": [
            "schemaVersion",
            "snapshotId",
            "path",
            "sha256",
            "environmentIdentitySha256",
            "observedAt"
          ],
          "additionalProperties": false,
          "maxProperties": 16
        },
        "liveChecks": {
          "type": "object",
          "properties": {
            "checkedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "maxLength": 100
            },
            "authorityEvidenceSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "resourceEvidenceSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "outputClaimEvidenceSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "settlementEvidenceSha256": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "selectedCapabilities": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "runtime",
                      "runner",
                      "role",
                      "tool",
                      "provider"
                    ]
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "evidenceSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "key",
                  "evidenceSha256"
                ],
                "additionalProperties": false,
                "maxProperties": 16
              }
            }
          },
          "required": [
            "checkedAt",
            "authorityEvidenceSha256",
            "resourceEvidenceSha256",
            "outputClaimEvidenceSha256",
            "settlementEvidenceSha256",
            "selectedCapabilities"
          ],
          "additionalProperties": false,
          "maxProperties": 16
        }
      },
      "required": [
        "pathsVerified",
        "rolesVerified",
        "evidence",
        "piVersion",
        "subagentsVersion"
      ],
      "additionalProperties": false,
      "maxProperties": 16
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 40,
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "key",
          "text"
        ],
        "additionalProperties": false,
        "maxProperties": 16
      },
      "minItems": 1,
      "maxItems": 4
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "label",
          "text"
        ],
        "additionalProperties": false,
        "maxProperties": 16
      },
      "minItems": 1,
      "maxItems": 8
    },
    "roles": {
      "type": "object",
      "properties": {
        "peer": {
          "enum": [
            "patronus-technical-reviewer-pi"
          ]
        },
        "disposition": {
          "enum": [
            "patronus-plan-reviewer-pi",
            "patronus-technical-reviewer-pi"
          ]
        }
      },
      "required": [],
      "additionalProperties": false,
      "maxProperties": 16
    },
    "runners": {
      "type": "object",
      "properties": {
        "native": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "available",
                "unverified",
                "unavailable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "executable": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1,
              "description": "Canonical observed executable, or nonempty UNAVAILABLE sentinel for an unavailable candidate."
            },
            "version": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1,
              "description": "Observed qualified version, or nonempty UNAVAILABLE sentinel for unavailable candidate."
            },
            "checkedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "contractVerified": {
              "type": "boolean"
            },
            "authEvidence": {
              "type": "string",
              "maxLength": 2000,
              "minLength": 1,
              "description": "Existing nonsecret version-qualified evidence when available; exactly UNVERIFIED for unverified auth, never an empty string."
            },
            "allowUnverified": {
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "reason",
            "executable",
            "version",
            "checkedAt",
            "contractVerified",
            "authEvidence",
            "allowUnverified"
          ],
          "additionalProperties": false,
          "maxProperties": 16,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "unverified"
                  }
                }
              },
              "then": {
                "properties": {
                  "authEvidence": {
                    "const": "UNVERIFIED"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "available"
                  }
                }
              },
              "then": {
                "properties": {
                  "authEvidence": {
                    "not": {
                      "enum": [
                        "UNVERIFIED",
                        "UNAVAILABLE"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "claude-code": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "available",
                "unverified",
                "unavailable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "executable": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1,
              "description": "Canonical observed executable, or nonempty UNAVAILABLE sentinel for an unavailable candidate."
            },
            "version": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1,
              "description": "Observed qualified version, or nonempty UNAVAILABLE sentinel for unavailable candidate."
            },
            "checkedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "contractVerified": {
              "type": "boolean"
            },
            "authEvidence": {
              "type": "string",
              "maxLength": 2000,
              "minLength": 1,
              "description": "Existing nonsecret version-qualified evidence when available; exactly UNVERIFIED for unverified auth, never an empty string."
            },
            "allowUnverified": {
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "reason",
            "executable",
            "version",
            "checkedAt",
            "contractVerified",
            "authEvidence",
            "allowUnverified"
          ],
          "additionalProperties": false,
          "maxProperties": 16,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "unverified"
                  }
                }
              },
              "then": {
                "properties": {
                  "authEvidence": {
                    "const": "UNVERIFIED"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "available"
                  }
                }
              },
              "then": {
                "properties": {
                  "authEvidence": {
                    "not": {
                      "enum": [
                        "UNVERIFIED",
                        "UNAVAILABLE"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "codex-exec": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "available",
                "unverified",
                "unavailable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "executable": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1,
              "description": "Canonical observed executable, or nonempty UNAVAILABLE sentinel for an unavailable candidate."
            },
            "version": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1,
              "description": "Observed qualified version, or nonempty UNAVAILABLE sentinel for unavailable candidate."
            },
            "checkedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "contractVerified": {
              "type": "boolean"
            },
            "authEvidence": {
              "type": "string",
              "maxLength": 2000,
              "minLength": 1,
              "description": "Existing nonsecret version-qualified evidence when available; exactly UNVERIFIED for unverified auth, never an empty string."
            },
            "allowUnverified": {
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "reason",
            "executable",
            "version",
            "checkedAt",
            "contractVerified",
            "authEvidence",
            "allowUnverified"
          ],
          "additionalProperties": false,
          "maxProperties": 16,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "unverified"
                  }
                }
              },
              "then": {
                "properties": {
                  "authEvidence": {
                    "const": "UNVERIFIED"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "available"
                  }
                }
              },
              "then": {
                "properties": {
                  "authEvidence": {
                    "not": {
                      "enum": [
                        "UNVERIFIED",
                        "UNAVAILABLE"
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false,
      "maxProperties": 16
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "spawnLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "allowReduced": {
      "type": "boolean"
    },
    "reviewSelection": {
      "type": "object",
      "properties": {
        "riskRationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "minLength": 1,
                "maxLength": 40
              },
              "engine": {
                "enum": [
                  "native",
                  "claude-code",
                  "codex-exec"
                ]
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "independence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "policy": {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "read-only"
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false,
                "maxProperties": 16
              }
            },
            "required": [
              "key",
              "engine",
              "purpose",
              "independence",
              "policy"
            ],
            "additionalProperties": false,
            "maxProperties": 16
          }
        },
        "disposition": {
          "enum": [
            "parent",
            "native"
          ]
        },
        "reducedReviewEvidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "validationEvidence": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "subjectSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "kind": {
              "const": "parent-validation"
            }
          },
          "required": [
            "path",
            "sha256",
            "subjectSha256",
            "kind"
          ],
          "additionalProperties": false,
          "maxProperties": 16
        }
      },
      "required": [
        "riskRationale",
        "reviewers",
        "disposition"
      ],
      "additionalProperties": false,
      "maxProperties": 16,
      "allOf": [
        {
          "if": {
            "properties": {
              "reviewers": {
                "maxItems": 1
              }
            },
            "required": [
              "reviewers"
            ]
          },
          "then": {
            "required": [
              "reducedReviewEvidence"
            ]
          },
          "else": {
            "not": {
              "required": [
                "reducedReviewEvidence"
              ]
            }
          }
        }
      ]
    }
  },
  "required": [
    "cwd",
    "outputDir",
    "sourceRevision",
    "sourceRoots",
    "authorization",
    "preflight",
    "tasks",
    "evidence",
    "roles",
    "runners",
    "concurrency",
    "spawnLimit",
    "timeoutMs"
  ],
  "additionalProperties": false,
  "maxProperties": 16,
  "allOf": [
    {
      "if": {
        "required": [
          "reviewSelection"
        ]
      },
      "then": {
        "not": {
          "required": [
            "allowReduced"
          ]
        },
        "properties": {
          "preflight": {
            "required": [
              "pathsVerified",
              "rolesVerified",
              "evidence",
              "piVersion",
              "subagentsVersion",
              "snapshotUse",
              "liveChecks"
            ]
          },
          "roles": {
            "required": [
              "peer"
            ]
          }
        }
      },
      "else": {
        "required": [
          "allowReduced"
        ],
        "properties": {
          "preflight": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "snapshotUse"
                  ]
                },
                {
                  "required": [
                    "liveChecks"
                  ]
                }
              ]
            }
          },
          "roles": {
            "required": [
              "peer",
              "disposition"
            ]
          },
          "runners": {
            "required": [
              "native",
              "claude-code",
              "codex-exec"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewSelection": {
            "properties": {
              "disposition": {
                "const": "native"
              }
            },
            "required": [
              "disposition"
            ]
          }
        },
        "required": [
          "reviewSelection"
        ]
      },
      "then": {
        "properties": {
          "roles": {
            "required": [
              "peer",
              "disposition"
            ]
          }
        }
      },
      "else": {
        "if": {
          "required": [
            "reviewSelection"
          ]
        },
        "then": {
          "properties": {
            "roles": {
              "required": [
                "peer"
              ],
              "not": {
                "required": [
                  "disposition"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
