{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow-implement-pi request",
  "description": "Pi-subagents 0.72.1 envelope: <=16384 UTF-8 JSON bytes total, nonempty strings, <=16 properties/object, <=64 items/array, nesting <=8. Inline evidence <=8192 UTF-8 JSON bytes total; script enforces byte and cross-field constraints. Parent assertions do not prove external facts.",
  "type": "object",
  "properties": {
    "cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/(?!.*(?:\\\\|//|/\\.\\.?(/|$)))[^\\u0000-\\u001f]*[^/]$"
    },
    "outputDir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/(?!.*(?:\\\\|//|/\\.\\.?(/|$)))[^\\u0000-\\u001f]*[^/]$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sourceRoots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^/(?!.*(?:\\\\|//|/\\.\\.?(/|$)))[^\\u0000-\\u001f]*[^/]$"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "authorization": {
      "type": "object",
      "properties": {
        "parentVerified": {
          "const": true
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 1,
          "maxItems": 8
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:\\.\\.|\\\\|\\*|\\?|\\[|\\]))[^\\u0000-\\u001f]+$"
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "parentVerified",
        "evidence",
        "actions",
        "files"
      ],
      "additionalProperties": false,
      "maxProperties": 16
    },
    "preflight": {
      "type": "object",
      "properties": {
        "pathsVerified": {
          "const": true
        },
        "rolesVerified": {
          "const": true
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "piVersion": {
          "const": "0.87.1"
        },
        "subagentsVersion": {
          "const": "0.72.1"
        },
        "snapshotUse": {
          "type": "object",
          "properties": {
            "schemaVersion": {"const": 1},
            "snapshotId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
            "path": {"type": "string", "pattern": "^/", "maxLength": 4096},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "environmentIdentitySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "observedAt": {"type": "string", "pattern": "Z$", "maxLength": 100}
          },
          "required": ["schemaVersion", "snapshotId", "path", "sha256", "environmentIdentitySha256", "observedAt"],
          "additionalProperties": false,
          "maxProperties": 16
        },
        "liveChecks": {
          "type": "object",
          "properties": {
            "checkedAt": {"type": "string", "pattern": "Z$", "maxLength": 100},
            "authorityEvidenceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "resourceEvidenceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "outputClaimEvidenceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "settlementEvidenceSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "selectedCapabilities": {
              "type": "array", "minItems": 1, "maxItems": 32,
              "items": {
                "type": "object",
                "properties": {
                  "kind": {"enum": ["runtime", "runner", "role", "tool", "provider"]},
                  "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 40},
                  "evidenceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                },
                "required": ["kind", "key", "evidenceSha256"],
                "additionalProperties": false
              }
            }
          },
          "required": ["checkedAt", "authorityEvidenceSha256", "resourceEvidenceSha256", "outputClaimEvidenceSha256", "settlementEvidenceSha256", "selectedCapabilities"],
          "additionalProperties": false,
          "maxProperties": 16
        }
      },
      "required": [
        "pathsVerified",
        "rolesVerified",
        "evidence",
        "piVersion",
        "subagentsVersion"
      ],
      "additionalProperties": false,
      "maxProperties": 16
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 40,
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "engine": {
            "enum": [
              "native",
              "claude-code-writer",
              "codex-exec-writer"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*(?::(?:off|minimal|low|medium|high|xhigh|max))?$(?![\\s\\S])",
            "description": "Native writers only: exact provider/id from the live Pi registry, optionally followed by a supported thinking suffix. Omit to retain the role default. Parent verifies model availability and authorization before dispatch."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^(?!/)(?!.*(?:\\.\\.|\\\\|\\*|\\?|\\[|\\]))[^\\u0000-\\u001f]+$"
            },
            "minItems": 1,
            "maxItems": 32
          }
        },
        "required": [
          "key",
          "text",
          "engine",
          "files"
        ],
        "allOf": [
          {
            "if": {
              "required": ["model"]
            },
            "then": {
              "properties": {
                "engine": {"const": "native"}
              }
            }
          }
        ],
        "additionalProperties": false,
        "maxProperties": 16
      },
      "minItems": 0,
      "maxItems": 10
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "label",
          "text"
        ],
        "additionalProperties": false,
        "maxProperties": 16
      },
      "minItems": 1,
      "maxItems": 8
    },
    "roles": {
      "type": "object",
      "properties": {
        "writer": {
          "enum": [
            "patronus-writer-pi"
          ]
        },
        "integrator": {
          "enum": [
            "patronus-writer-pi"
          ]
        },
        "validator": {
          "enum": [
            "patronus-technical-reviewer-pi"
          ]
        }
      },
      "additionalProperties": false,
      "maxProperties": 16
    },
    "runners": {
      "type": "object",
      "properties": {
        "native": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "available",
                "unverified",
                "unavailable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "executable": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1,
              "description": "Canonical observed executable, or nonempty UNAVAILABLE sentinel for an unavailable candidate."
            },
            "version": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1,
              "description": "Observed qualified version, or nonempty UNAVAILABLE sentinel for unavailable candidate."
            },
            "checkedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "contractVerified": {
              "type": "boolean"
            },
            "authEvidence": {
              "type": "string",
              "maxLength": 2000,
              "minLength": 1,
              "description": "Existing nonsecret version-qualified evidence when available; exactly UNVERIFIED for unverified auth, never an empty string."
            },
            "allowUnverified": {
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "reason",
            "executable",
            "version",
            "checkedAt",
            "contractVerified",
            "authEvidence",
            "allowUnverified"
          ],
          "additionalProperties": false,
          "maxProperties": 16,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "unverified"
                  }
                }
              },
              "then": {
                "properties": {
                  "authEvidence": {
                    "const": "UNVERIFIED"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "available"
                  }
                }
              },
              "then": {
                "properties": {
                  "authEvidence": {
                    "not": {
                      "enum": [
                        "UNVERIFIED",
                        "UNAVAILABLE"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "claude-code-writer": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "available",
                "unverified",
                "unavailable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "executable": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1,
              "description": "Canonical observed executable, or nonempty UNAVAILABLE sentinel for an unavailable candidate."
            },
            "version": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1,
              "description": "Observed qualified version, or nonempty UNAVAILABLE sentinel for unavailable candidate."
            },
            "checkedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "contractVerified": {
              "type": "boolean"
            },
            "authEvidence": {
              "type": "string",
              "maxLength": 2000,
              "minLength": 1,
              "description": "Existing nonsecret version-qualified evidence when available; exactly UNVERIFIED for unverified auth, never an empty string."
            },
            "allowUnverified": {
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "reason",
            "executable",
            "version",
            "checkedAt",
            "contractVerified",
            "authEvidence",
            "allowUnverified"
          ],
          "additionalProperties": false,
          "maxProperties": 16,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "unverified"
                  }
                }
              },
              "then": {
                "properties": {
                  "authEvidence": {
                    "const": "UNVERIFIED"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "available"
                  }
                }
              },
              "then": {
                "properties": {
                  "authEvidence": {
                    "not": {
                      "enum": [
                        "UNVERIFIED",
                        "UNAVAILABLE"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "codex-exec-writer": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "available",
                "unverified",
                "unavailable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "executable": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1,
              "description": "Canonical observed executable, or nonempty UNAVAILABLE sentinel for an unavailable candidate."
            },
            "version": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1,
              "description": "Observed qualified version, or nonempty UNAVAILABLE sentinel for unavailable candidate."
            },
            "checkedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "contractVerified": {
              "type": "boolean"
            },
            "authEvidence": {
              "type": "string",
              "maxLength": 2000,
              "minLength": 1,
              "description": "Existing nonsecret version-qualified evidence when available; exactly UNVERIFIED for unverified auth, never an empty string."
            },
            "allowUnverified": {
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "reason",
            "executable",
            "version",
            "checkedAt",
            "contractVerified",
            "authEvidence",
            "allowUnverified"
          ],
          "additionalProperties": false,
          "maxProperties": 16,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "unverified"
                  }
                }
              },
              "then": {
                "properties": {
                  "authEvidence": {
                    "const": "UNVERIFIED"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "available"
                  }
                }
              },
              "then": {
                "properties": {
                  "authEvidence": {
                    "not": {
                      "enum": [
                        "UNVERIFIED",
                        "UNAVAILABLE"
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "native"
      ],
      "additionalProperties": false,
      "maxProperties": 16
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "spawnLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "baseRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "integrationCwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/(?!.*(?:\\\\|//|/\\.\\.?(/|$)))[^\\u0000-\\u001f]*[^/]$"
    },
    "validationCommands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 1,
      "maxItems": 8
    },
    "execution": {
      "type": "object",
      "properties": {
        "operation": {"enum": ["write", "integrate", "validate"]},
        "baseRef": {"type": "string", "minLength": 1, "maxLength": 200},
        "integrationCwd": {"type": "string", "pattern": "^/", "maxLength": 4096},
        "predecessors": {
          "type": "array", "minItems": 0, "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 40},
              "runId": {"type": "string", "minLength": 1, "maxLength": 200},
              "agent": {"type": "string", "minLength": 1, "maxLength": 200},
              "report": {"$ref": "#/$defs/evidenceReference"},
              "handoff": {"$ref": "#/$defs/evidenceReference"},
              "delivery": {"$ref": "#/$defs/evidenceReference"}
            },
            "required": ["key", "runId", "agent", "report", "handoff", "delivery"],
            "additionalProperties": false
          }
        },
        "validation": {
          "type": "object",
          "properties": {
            "level": {"enum": ["parent-direct", "bounded-child", "deep"]},
            "risk": {
              "type": "object",
              "properties": {
                "changedBehavior": {"type": "string", "minLength": 1, "maxLength": 2000},
                "falsePassConsequence": {"type": "string", "minLength": 1, "maxLength": 2000},
                "determinism": {"type": "string", "minLength": 1, "maxLength": 2000},
                "novelty": {"type": "string", "minLength": 1, "maxLength": 2000},
                "blastRadius": {"type": "string", "minLength": 1, "maxLength": 2000},
                "costJustification": {"type": "string", "minLength": 1, "maxLength": 2000}
              },
              "required": ["changedBehavior", "falsePassConsequence", "determinism", "novelty", "blastRadius", "costJustification"],
              "additionalProperties": false
            },
            "question": {"type": "string", "minLength": 1, "maxLength": 2000},
            "acceptancePoint": {"type": "string", "minLength": 1, "maxLength": 2000},
            "subjectContext": {"type": "string", "minLength": 1, "maxLength": 2000},
            "checks": {
              "type": "array", "minItems": 1, "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 40},
                  "argv": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
                  "kind": {"enum": ["command", "deterministic-observation"]}
                },
                "required": ["key", "argv", "kind"],
                "additionalProperties": false
              }
            },
            "priorShortfall": {"$ref": "#/$defs/evidenceReference"},
            "approvalEvidence": {"type": "string", "minLength": 1, "maxLength": 2000}
          },
          "required": ["level", "risk", "question", "acceptancePoint", "subjectContext", "checks"],
          "additionalProperties": false
        }
      },
      "required": ["operation", "predecessors"],
      "additionalProperties": false,
      "maxProperties": 16
    }
  },
  "required": [
    "cwd",
    "outputDir",
    "sourceRevision",
    "sourceRoots",
    "authorization",
    "preflight",
    "tasks",
    "evidence",
    "roles",
    "runners",
    "concurrency",
    "spawnLimit",
    "timeoutMs"
  ],
  "allOf": [
    {
      "if": {"required": ["execution"]},
      "then": {
        "not": {"anyOf": [{"required": ["baseRef"]}, {"required": ["integrationCwd"]}, {"required": ["validationCommands"]}]},
        "properties": {"preflight": {"required": ["pathsVerified", "rolesVerified", "evidence", "piVersion", "subagentsVersion", "snapshotUse", "liveChecks"]}}
      },
      "else": {"required": ["baseRef", "integrationCwd", "validationCommands"]}
    }
  ],
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "pattern": "^/", "maxLength": 4096},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "subjectSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kind": {"enum": ["parent-validation", "target-delivery", "shortfall", "review", "report", "handoff"]}
      },
      "required": ["path", "sha256", "subjectSha256", "kind"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "maxProperties": 16
}
