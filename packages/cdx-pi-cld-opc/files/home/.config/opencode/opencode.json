{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "provider": {
    "openai": {
      "whitelist": ["gpt-6.1-sol", "gpt-6-astra"],
      "options": {
        "baseURL": "https://chatgpt.com/backend-api/codex",
        "apiKey": "oai-oat01-proxy-managed",
        "headers": {
          "OpenAI-Beta": "responses=experimental"
        }
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol (sandbox proxy)"
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra (sandbox proxy)"
        }
      }
    },
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
  }
}
